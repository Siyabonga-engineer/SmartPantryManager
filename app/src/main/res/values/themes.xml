<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= App theme ================= -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_light</item>
        <item name="colorOnPrimaryContainer">@color/green_dark</item>
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- The pill behind the selected bottom-navigation tab -->
        <item name="colorSecondaryContainer">@color/green_light</item>
        <item name="colorOnSecondaryContainer">@color/green_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- Dark status-bar icons on the light background -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />

    <!-- ================= Reusable text styles ================= -->

    <!-- Small green label above a screen title, e.g. "SMART PANTRY" -->
    <style name="SmartPantry.Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <!-- Empty "parent" style. Every style below is named SmartPantry.Something,
     and Android needs a style called SmartPantry to exist for those names to work. -->
    <style name="SmartPantry" />

    <!-- Big bold screen title, e.g. "My Pantry" -->
    <style name="SmartPantry.ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Grey line under a title -->
    <style name="SmartPantry.Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Heading for a section of a screen, e.g. "Your ingredients" -->
    <style name="SmartPantry.SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rounded "pill" label, e.g. "6 items" or "Exp 25 Oct". Colour set with backgroundTint. -->
    <style name="SmartPantry.Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ================= Reusable component styles ================= -->

    <!-- White card with a thin border and rounded corners (no shadow) -->
    <style name="SmartPantry.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Rounded text boxes used on the Add/Edit form -->
    <style name="SmartPantry.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
        <item name="startIconTint">@color/green_primary</item>
    </style>

    <style name="SmartPantry.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>
</resources>